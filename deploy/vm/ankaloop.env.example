# AnkaLoop runtime configuration for the VM deployment.
# Copy to deploy/vm/ankaloop.env, fill in real values, scp to the server.
# On the server it lives at /etc/ankaloop/ankaloop.env with mode 0600.
# NEVER commit it.
#
# Same keys as deploy/k8s/secret.example.yaml — you can copy values from there.
OPENAI_API_KEY=replace-with-your-api-key
ANKA_CHAT_MODEL=replace-with-your-model
ANKA_OPENAI_BASE=https://your-openai-compatible-endpoint/v1

# Optional: Telegram polling bot (no inbound port needed).
# WARNING: only ONE running instance per bot token. If the K8s deployment uses
# the same token, one of them will fail with telegram.error.Conflict.
# ANKA_TELEGRAM_BOT_TOKEN=123456:replace-me
# ANKA_TELEGRAM_ALLOWED_USERS=123456789
# ANKA_TELEGRAM_ADMIN_USERS=123456789

# Optional: bind address/port (defaults shown). Keep 127.0.0.1 unless you put
# an authenticating reverse proxy in front — the API has no built-in auth.
# ANKALOOP_VM_HOST=127.0.0.1
# ANKALOOP_VM_PORT=8080
